# Общая таблица лидеров (Supabase). Скопируйте в .env и подставьте значения своего проекта:
# Supabase → Project Settings → API (Data API). Ключ — только публичный (anon / publishable),
# секретный ключ (service_role / secret) сюда не класть.
VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_KEY=ваш-публичный-ключ
