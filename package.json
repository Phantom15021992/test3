{
  "name": "match3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "simulate": "vite-node scripts/simulate.ts",
    "build:function": "esbuild src/server/entry.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/smooth-handler/index.ts --log-level=warning",
    "deploy:function": "npm run build:function && npx supabase functions deploy smooth-handler --project-ref szieuersvybdqdzhstpx --use-api --no-verify-jwt"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
